# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode Template
#
# Complete the TODO prompts below with your own pseudocode.
# Keep this file in .pseudo format for submission.
#
# Use clear indentation to show decisions and repeated behavior.
# Your finished pseudocode should address every requirement in the
# current Module Four Assignment Guidelines and Rubric.

START hilow_game

    # Establish a valid guessing range.
    PUT "Welcome to the higher/lower game, Bella!"
GET lower_bound
GET upper_bound

WHILE lower_bound >= upper_bound
    PUT "The lower bound must be less than the upper bound."
    GET lower_bound
    GET upper_bound
ENDWHILE

    # Establish the number the player is trying to guess.
    LET random_number = RANDOM(lower_bound, upper_bound)

    # Play the game.
    PUT "Great, now guess a number between ", lower_bound, " and ", upper_bound
GET guess

WHILE guess < lower_bound OR guess > upper_bound
    PUT "Please enter a number between ", lower_bound, " and ", upper_bound
    GET guess
ENDWHILE
    WHILE guess != random_number
        IF guess < random_number
    PUT "Nope, too low."
ELSE
    PUT "Nope, too high."
ENDIF
        PUT "Guess another number:"
GET guess

WHILE guess < lower_bound OR guess > upper_bound
    PUT "Please enter a number between ", lower_bound, " and ", upper_bound
    GET guess
ENDWHILE
ENDWHILE
PUT "You got it!"

END hilow_game

